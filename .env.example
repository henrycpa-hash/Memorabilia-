# --- Security hardening (gateway edge) ---
# Strong JWT signing secret — REQUIRED in production (gateway refuses to start without it)
JWT_SECRET=
# Strict CORS allow-list (comma-separated origins). Unset = reflect origin (dev only)
CROWNX_CORS_ORIGINS=
# Per-IP rate limit (requests per window) + window size in ms
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
# Max request body size in bytes (oversized-payload / DoS defence)
GATEWAY_BODY_LIMIT=1048576
